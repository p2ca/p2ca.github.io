@inproceedings{song2026darsd,
  abbr         = {ACM AI Summit},
  bibtex_show  = {true},
  title        = {Domain-Adaptive Reservoir Inflow Forecasting via Invariant-Basis Representation Decomposition},
  author       = {Song, Haojun and Hu, Pengfei and Han, Xiaoxue and Ning, Yue and Lu, Dan and Fan, Ming},
  booktitle    = {ACM AI Leadership Summit},
  year         = {2026},
  month        = aug,
  address      = {Atlanta, GA, USA},
  selected     = {true},
  preview      = {darsd_architecture.png},
  abstract     = {Forecasting inflow at data-scarce reservoirs often requires transferring knowledge from data-rich sites, but hydroclimatic shifts make it unclear what should transfer. To address this, we organize reservoir information into three sources: the dynamic hydrometeorological sequence, static reservoir attributes, and latent reservoir context. We propose DARSD-ResMetaLSTM, which encodes the dynamic hydrometeorological sequence with reservoir-specific context, decomposes the resulting latent state into shared and reservoir-specific components with a learnable invariant basis, and then uses static reservoir attributes to refine the decomposed forecast state. We evaluated it on 33 U.S. reservoirs across six snow/rain transfer scenarios, and it outperforms alignment methods in both cross-regime directions, showing that explicit decomposition enables more reliable use of reservoir information under domain shift.}
}
